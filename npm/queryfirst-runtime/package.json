{
  "name": "@queryfirst/runtime",
  "version": "0.1.0",
  "description": "Result-cardinality wrappers (one/maybe/none) for Queryfirst-generated pgtyped queries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbsimonbb/queryfirst.git",
    "directory": "npm/queryfirst-runtime"
  },
  "homepage": "https://github.com/bbsimonbb/queryfirst#readme",
  "bugs": {
    "url": "https://github.com/bbsimonbb/queryfirst/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@pgtyped/runtime": "^2.1.0"
  },
  "devDependencies": {
    "@pgtyped/runtime": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
